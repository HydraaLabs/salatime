APP_NAME=SalaTime
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
PUBLIC_SITE_URL=http://127.0.0.1:8000
# Install with the CLI instructions in README.md; no purchase code is required.
APP_INSTALLED=true

LOG_CHANNEL=stack
LOG_LEVEL=debug
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=salatime
DB_USERNAME=salatime
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Local mail is logged, not delivered. Configure SMTP before enabling account mail.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"

# Optional integrations: use your own keys. Never commit a populated .env.
GOOGLE_MAPS_API_KEY=
ISLAMIC_NAME_API_KEY=
ONEMIN_API_KEY=
VITE_IS_DEMO=false

# Mobile accounts are separate from administrator accounts.
MOBILE_AUTH_ENABLED=true
MOBILE_AUTH_MAIL_ENABLED=false
# Comma-separated OIDC audiences from your own Google project.
MOBILE_GOOGLE_CLIENT_IDS=
MOBILE_GOOGLE_SERVER_CLIENT_ID=
MOBILE_GOOGLE_IOS_CLIENT_ID=
MOBILE_APPLE_CLIENT_IDS=
MOBILE_APPLE_IOS_CLIENT_ID=net.salatime.app
MOBILE_APPLE_SERVICE_ID=
MOBILE_APPLE_TEAM_ID=
MOBILE_APPLE_KEY_ID=
# Absolute path outside public/, readable only by the PHP user.
MOBILE_APPLE_PRIVATE_KEY_PATH=
MOBILE_APPLE_REDIRECT_URI=
MOBILE_APPLE_ANDROID_PACKAGE=net.salatime.app
