ONEMIN_API_KEY=
PUBLIC_SITE_URL=https://salatime.net

# SalaTime mobile accounts (separate from administrator accounts)
MOBILE_AUTH_ENABLED=true
# Enable only after SMTP has been configured and a test email confirmed.
MOBILE_AUTH_MAIL_ENABLED=false
# Comma-separated OIDC audiences. Never use arbitrary client-provided audiences.
MOBILE_GOOGLE_CLIENT_IDS=
MOBILE_GOOGLE_SERVER_CLIENT_ID=
MOBILE_GOOGLE_IOS_CLIENT_ID=
# Include iOS bundle ID and Android/web Service ID as appropriate.
MOBILE_APPLE_CLIENT_IDS=
MOBILE_APPLE_SERVICE_ID=
MOBILE_APPLE_TEAM_ID=
MOBILE_APPLE_KEY_ID=
# Absolute path outside the public directory, readable only by the PHP user.
MOBILE_APPLE_PRIVATE_KEY_PATH=
MOBILE_APPLE_REDIRECT_URI=https://salatime.net/api/mobile/auth/apple/callback
MOBILE_APPLE_ANDROID_PACKAGE=net.salatime.app
