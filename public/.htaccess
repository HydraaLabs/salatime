<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On
    RewriteOptions AllowNoSlash

    # Work with either DocumentRoot: project root or public/ directly.
    # Only redirect client-supplied /public paths, never an internal rewrite.
    RewriteCond %{HTTP_HOST} ^(?:www\.)?salatime\.net(?::[0-9]+)?$ [NC]
    RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
    RewriteCond %{THE_REQUEST} "\s/+public(?:/+([^\s?]*?))?/*(?:\?|\s)" [NC]
    RewriteRule ^ https://salatime.net/%1 [R=301,L,NE]

    # Preserve actual asset directories while keeping the public HTTPS origin.
    RewriteCond %{HTTP_HOST} ^(?:www\.)?salatime\.net(?::[0-9]+)?$ [NC]
    RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteCond %{THE_REQUEST} "\s/+([^\s?]*[^/\s?])(?:\?|\s)"
    RewriteRule ^ https://salatime.net/%1/ [R=301,L,NE]

    RewriteCond %{HTTP_HOST} ^(?:www\.)?salatime\.net(?::[0-9]+)?$ [NC]
    RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{THE_REQUEST} "\s/+([^\s?]+?)/+(?:\?|\s)"
    RewriteRule ^ https://salatime.net/%1 [R=301,L,NE]

    # Keep one indexable origin: HTTPS without www.
    RewriteCond %{HTTP_HOST} ^www\.salatime\.net$ [NC]
    RewriteCond %{THE_REQUEST} "\s/+([^\s?]*)(?:\?|\s)"
    RewriteRule ^ https://salatime.net/%1 [R=301,L,NE]

    RewriteCond %{HTTP_HOST} ^salatime\.net$ [NC]
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
    RewriteCond %{THE_REQUEST} "\s/+([^\s?]*)(?:\?|\s)"
    RewriteRule ^ https://salatime.net/%1 [R=301,L,NE]

    # LiteSpeed page cache (24 hours, public) for static GET API data:
    # quran, dhikr, dua, reciters, wallpapers... Purge = empty the LSWS cache dir.
    <IfModule LiteSpeed>
        RewriteCond %{REQUEST_METHOD} ^GET$
        RewriteCond %{HTTP:Authorization} ^$
        RewriteRule ^api/(chapters|verses|juzes|translators|dua-list|dua-details|dhikr-list|dhikr-details|sifat-name-list|sifat-name-details|haram-code-list|get-cities|reciters|reciter-sura|wallpapers|wallpaper-category) - [E=Cache-Control:max-age=86400]
    </IfModule>

    # Never cache APK downloads (Cloudflare would serve stale builds)
    <IfModule mod_headers.c>
        <FilesMatch "\.apk$">
            Header set Cache-Control "no-cache, no-store, must-revalidate"
            Header set Pragma "no-cache"
            Header set Expires "0"
        </FilesMatch>
    </IfModule>

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
